# ASFWMS configuration example - copy to .env and edit as needed.
# Do not commit or publicly share this file.
# Set APP_HOST=127.0.0.1 for local-only access or keep your current bind setting.
APP_HOST=127.0.0.1
APP_PORT=3000

# Optional public HTTPS origin. Example: https://asfwms2.bcc-edu.ph
APP_PUBLIC_URL=

# SQLite database location, relative to the project root.
DB_DRIVER=sqlite
DB_PATH=database/database.db

# Optional SMTP email settings for timetable delivery and account recovery.
# Fill in your own credentials; a blank password disables sending.
SMTP_EMAIL=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
